# Environment Variables Example
# Copy this file to .env, .env.development, .env.test, or .env.production
# and replace these example values with your actual values

# Server
PORT=3000
NODE_ENV=development

# Database - Replace with your actual database credentials
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=your_database_name
DB_USER=your_username
DB_PASSWORD=your_secure_password

# JWT - Use a strong random string for JWT_SECRET in production!
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_this_with_a_random_secure_string
JWT_EXPIRES_IN=1d

# Messaging
SOCKET_PORT=4000

# Add additional environment variables below as needed
# API_KEY=your_api_key
